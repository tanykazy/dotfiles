#!/bin/sh

readonly REPOSITORY='origin'
readonly REFSPEC='main'

readonly SCRIPT_DIR=$(cd $(dirname $0); pwd)
readonly DOTFILESPATH=$(cd $(dirname ${SCRIPT_DIR}); pwd)

readonly OPERATINGSYSTEM=$(uname --operating-system)
readonly MACHINE=$(uname --machine)
readonly MESSAGE="Update from ${MACHINE} ${OPERATINGSYSTEM} at $(date)"

git add -v ${DOTFILESPATH}
git commit -v -m "${MESSAGE}"
git push -v ${REPOSITORY} ${REFSPEC}:${MACHINE}/${OPERATINGSYSTEM}
